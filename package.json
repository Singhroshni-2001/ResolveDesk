{
  "name": "resolvedesk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "verify:models": "node scripts/verify-models.mjs",
    "verify:gemini": "node scripts/verify-gemini.mjs",
    "test:customers": "node scripts/verify-customers.mjs",
    "test:ingestion": "node scripts/verify-ingestion.mjs",
    "verify:release": "node scripts/check-release.mjs",
    "test:db": "node scripts/test-database.mjs",
    "test:live": "node scripts/verify-live-workflows.mjs",
    "verify:connection": "node scripts/check-connection.mjs",
    "metrics:local": "node scripts/measure-local.mjs",
    "metrics:live": "node scripts/measure-live.mjs",
    "metrics:report": "node scripts/render-metrics.mjs",
    "verify": "node scripts/verify.mjs",
    "format": "prettier --write app components lib scripts tests types next.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "lucide-react": "^0.468.0",
